# Neon: copia las dos cadenas desde el dashboard (Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (Storage > Blob > crea el store; el token se genera solo al conectarlo al proyecto)
BLOB_READ_WRITE_TOKEN=

# Contraseña de la app (la usas solo tú). Se envía en el header x-app-password.
APP_PASSWORD=cambia-esto

# Frontend
VITE_APP_NAME=Recetario Navideño
